{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "DoriosCore": ["types/DoriosCore/index.d.ts"],
      "DoriosCore/index.js": ["types/DoriosCore/index.d.ts"],
      "DoriosLib": ["types/DoriosLib/index.d.ts"],
      "DoriosLib/index.js": ["types/DoriosLib/index.d.ts"],
      "DoriosLib/*": ["types/DoriosLib/index.d.ts"],
      "ExampleCore": ["BP/scripts/ExampleCore/index.js"],
      "ExampleCore/index.js": ["BP/scripts/ExampleCore/index.js"],
      "ExampleCore/*": ["BP/scripts/ExampleCore/*"],
      "@scripts/*": ["BP/scripts/*"]
    },
    "skipLibCheck": true
  },
  "include": [
    "BP/scripts/main.js",
    "BP/scripts/ExampleCore/**/*.js",
    "BP/scripts/config/**/*.js",
    "BP/scripts/examples/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".regolith",
    "builds",
    "dist",
    "BP/scripts/DoriosCore",
    "BP/scripts/DoriosLib"
  ]
}
