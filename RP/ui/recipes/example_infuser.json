{
  "namespace": "example_infuser_recipes",

  "recipe_toggle@uc.recipe_toggle": {
    "$toggle_name": "example_infuser_recipes"
  },

  "recipe_catalyst@uc.infuser_recipe_catalyst": {
    "$recipe_catalyst_index": 4,
    "$recipe_catalyst_offset": [2, -17],
    "$recipe_catalyst_size": [16, 16]
  },

  "recipe_input@uc.infuser_recipe_input": {
    "$recipe_input_index": 3,
    "$recipe_input_offset": [2, 10],
    "$recipe_input_size": [16, 16]
  },

  "recipe_output@uc.infuser_recipe_output": {
    "$recipe_output_index": 5,
    "$recipe_output_offset": [64, 3],
    "$recipe_output_size": [24, 24]
  },

  "recipe_buttons": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [126, "100%c"],
    "offset": [0, 0],
    "orientation": "vertical",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "recipes_toggle_button",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible",
        "resolve_sibling_scope": false
      }
    ],
    "controls": [
      {
        "recipe_row_0": {
          "type": "panel",
          "size": [126, 18],
          "controls": [
            {
              "energized_alloy_toggle@example_infuser_recipes.recipe_toggle": {
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "$toggle_index": 0,
                "$toggle_hover_text": "item.utilitycraft:example_energized_alloy",
                "$toggle_control_name": "energized_alloy_recipe",
                "$recipe_icon": "textures/items/ores/energized_iron_ingot",
                "offset": [0, 0]
              }
            },
            {
              "crystal_shard_toggle@example_infuser_recipes.recipe_toggle": {
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "$toggle_index": 1,
                "$toggle_hover_text": "item.utilitycraft:example_crystal_shard",
                "$toggle_control_name": "crystal_shard_recipe",
                "$recipe_icon": "textures/items/pebbles/emerald_shard",
                "offset": [18, 0]
              }
            }
          ]
        }
      },
      {
        "bottom_padding": {
          "type": "panel",
          "size": [126, 8]
        }
      }
    ]
  },

  "recipes_side_panel": {
    "type": "collection_panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [154, 166],
    "offset": [-91, 0],
    "layer": 10,
    "collection_name": "container_items",
    "$item_collection_name": "container_items",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "recipes_toggle_button",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible",
        "resolve_sibling_scope": false
      }
    ],
    "controls": [
      {
        "panel_bg": {
          "type": "image",
          "texture": "textures/ui/background/background_panel",
          "size": [140, 145],
          "offset": [7, 10.5],
          "layer": -5
        }
      },
      {
        "top_bg": {
          "type": "image",
          "texture": "textures/ui/background/dark_top_tab",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "size": [140, 24],
          "offset": [7, 0],
          "layer": -6
        }
      },
      {
        "title": {
          "type": "label",
          "text": "ui.utilitycraft:recipes_panel.name",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [7, 7],
          "color": [0.9, 0.9, 0.9],
          "layer": -3,
          "font_scale_factor": 1
        }
      },
      {
        "recipes_grid_bg": {
          "type": "image",
          "texture": "textures/ui/recipe_grid_bg",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [128, 134],
          "offset": [20, 27],
          "layer": -4
        }
      },
      {
        "recipes_grid_border": {
          "type": "image",
          "texture": "textures/ui/background_border",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [128, 134],
          "offset": [20, 27],
          "layer": 4
        }
      },
      {
        "recipes_scroll@common.scrolling_panel": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [142, 130],
          "offset": [13, -2],
          "$show_background": false,
          "layer": -2,
          "$scroll_size": [4, "100% - 4px"],
          "$scrolling_pane_size": ["100% + 6px", "100% + 3px"],
          "$scrolling_pane_offset": [-2, 30],
          "$scroll_view_port_size": ["100% + 80px", "100% + 3px"],
          "$scroll_view_port_max_size": ["100% + 80px", "100% + 3px"],
          "$scroll_view_port_offset": [-44, 0],
          "$scrolling_pane_size_touch": ["100% + 6px", "100% + 3px"],
          "$scrolling_pane_offset_touch": [0, 30],
          "$scroll_view_port_size_touch": ["100% + 80px", "100% + 3px"],
          "$scroll_view_port_max_size_touch": ["100% + 80px", "100% + 3px"],
          "$scroll_view_port_offset_touch": [-46, 0],
          "$scroll_size_touch": [4, "100% - 4px"],
          "$scroll_box_visible_touch": true,
          "$use_touch_mode": false,
          "$scrolling_content": "example_infuser_recipes.recipe_buttons",
          "$scroll_track_image_control": "common.empty_image"
        }
      }
    ]
  },

  "recipes_connector": {
    "type": "panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [12, 160],
    "offset": [-14, 0],
    "layer": -20,
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "recipes_toggle_button",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible",
        "resolve_sibling_scope": false
      }
    ],
    "controls": [
      {
        "connector_bg": {
          "type": "image",
          "texture": "textures/ui/recipe_book_side_toggle_dark",
          "size": [12, 160],
          "layer": 0
        }
      }
    ]
  },

  "recipe_overlays": {
    "type": "collection_panel",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [162, 72],
    "collection_name": "container_items",
    "$item_collection_name": "container_items",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "recipes_toggle_button",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible",
        "resolve_sibling_scope": false
      }
    ],
    "controls": [
      {
        "energized_alloy_panel@uc.recipe_panel": {
          "$recipe_control_name": "energized_alloy_recipe",
          "controls": [
            {
              "catalyst@example_infuser_recipes.recipe_catalyst": {
                "$slot_item_texture": "textures/items/redstone_dust",
                "$slot_hover_text": "item.redstone.name",
                "$has_slot_hover": true,
                "$slot_count_text": "2",
                "$has_slot_count": true
              }
            },
            {
              "input@example_infuser_recipes.recipe_input": {
                "$slot_item_texture": "textures/items/iron_ingot",
                "$slot_hover_text": "item.iron_ingot.name",
                "$has_slot_hover": true
              }
            },
            {
              "output@example_infuser_recipes.recipe_output": {
                "$slot_item_texture": "textures/items/ores/energized_iron_ingot",
                "$slot_hover_text": "item.utilitycraft:example_energized_alloy",
                "$has_slot_hover": true
              }
            }
          ]
        }
      },
      {
        "crystal_shard_panel@uc.recipe_panel": {
          "$recipe_control_name": "crystal_shard_recipe",
          "controls": [
            {
              "catalyst@example_infuser_recipes.recipe_catalyst": {
                "$slot_item_texture": "textures/items/glowstone_dust",
                "$slot_hover_text": "item.glowstone_dust.name",
                "$has_slot_hover": true
              }
            },
            {
              "input@example_infuser_recipes.recipe_input": {
                "$slot_item_texture": "textures/items/copper_ingot",
                "$slot_hover_text": "item.copper_ingot.name",
                "$has_slot_hover": true
              }
            },
            {
              "output@example_infuser_recipes.recipe_output": {
                "$slot_item_texture": "textures/items/pebbles/emerald_shard",
                "$slot_hover_text": "item.utilitycraft:example_crystal_shard",
                "$has_slot_hover": true,
                "$slot_count_text": "2",
                "$has_slot_count": true
              }
            }
          ]
        }
      }
    ]
  },

  "utility_panel": {
    "type": "panel",
    "controls": [
      {
        "container_gamepad_helpers@common.container_gamepad_helpers": {}
      },
      {
        "flying_item_renderer@common.flying_item_renderer": {
          "layer": 40
        }
      },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {}
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {}
      },
      {
        "root_panel@common.root_panel": {
          "layer": 1,
          "controls": [
            {
              "chest_panel": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  {
                    "recipes_side_panel@example_infuser_recipes.recipes_side_panel": {}
                  },
                  {
                    "recipes_connector@example_infuser_recipes.recipes_connector": {}
                  },
                  {
                    "normal_content": {
                      "type": "panel",
                      "bindings": [
                        {
                          "binding_type": "view",
                          "source_control_name": "recipes_toggle_button",
                          "source_property_name": "(not (#toggle_state))",
                          "target_property_name": "#visible",
                          "resolve_sibling_scope": false
                        }
                      ],
                      "controls": [
                        {
                          "common_panel@common.common_panel": {
                            "$show_close_button": false
                          }
                        },
                        {
                          "view_top_bar@uc.machine_recipe_view_top_bar": {
                            "$machine_toggle_unchecked": "textures/ui/toggle_button/tab_pressed",
                            "$machine_toggle_checked": "textures/ui/toggle_button/tab_pressed",
                            "$machine_toggle_unchecked_hover": "textures/ui/toggle_button/tab_hover_pressed",
                            "$machine_toggle_checked_hover": "textures/ui/toggle_button/tab_hover_pressed",
                            "$recipes_toggle_checked": "textures/ui/toggle_button/tab",
                            "$recipes_toggle_checked_hover": "textures/ui/toggle_button/tab_hover"
                          }
                        },
                        {
                          "infuser_top@example_ui.infuser_top": {}
                        },
                        {
                          "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {}
                        },
                        {
                          "hotbar_grid@common.hotbar_grid_template": {}
                        },
                        {
                          "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {}
                        }
                      ]
                    }
                  },
                  {
                    "recipes_content": {
                      "type": "panel",
                      "offset": [76, 0],
                      "bindings": [
                        {
                          "binding_type": "view",
                          "source_control_name": "recipes_toggle_button",
                          "source_property_name": "#toggle_state",
                          "target_property_name": "#visible",
                          "resolve_sibling_scope": false
                        }
                      ],
                      "controls": [
                        {
                          "common_panel@common.common_panel": {
                            "$show_close_button": false
                          }
                        },
                        {
                          "view_top_bar@uc.machine_recipe_view_top_bar": {
                            "$machine_toggle_default_state": false,
                            "$recipes_toggle_default_state": true,
                            "$machine_toggle_checked": "textures/ui/toggle_button/tab",
                            "$machine_toggle_checked_hover": "textures/ui/toggle_button/tab_hover",
                            "$recipes_toggle_unchecked": "textures/ui/toggle_button/tab_pressed",
                            "$recipes_toggle_checked": "textures/ui/toggle_button/tab_pressed",
                            "$recipes_toggle_unchecked_hover": "textures/ui/toggle_button/tab_hover_pressed",
                            "$recipes_toggle_checked_hover": "textures/ui/toggle_button/tab_hover_pressed"
                          }
                        },
                        {
                          "infuser_top@example_ui.infuser_top": {
                            "$energy_bar_offset": [97, 64],
                            "$energy_bar_bg_texture": "textures/ui/toggle_button/right_bg",
                            "$right_machine_tabs_name": "right_machine_tabs_recipes",
                            "$upgrade_toggle_control_name": "upgrade_toggle_button_recipes",
                            "$io_toggle_control_name": "io_toggle_button_recipes",
                            "$io_config_tabs_name": "io_config_tabs_recipes",
                            "$io_items_toggle_control_name": "io_items_toggle_button_recipes",
                            "$io_fluids_toggle_control_name": "io_fluids_toggle_button_recipes",
                            "$info_toggle_control_name": "info_toggle_button_recipes"
                          }
                        },
                        {
                          "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {}
                        },
                        {
                          "hotbar_grid@common.hotbar_grid_template": {}
                        },
                        {
                          "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {}
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "inventory_selected_icon_button@common.inventory_selected_icon_button": {}
            },
            {
              "gamepad_cursor@common.gamepad_cursor_button": {}
            }
          ]
        }
      }
    ]
  }
}
